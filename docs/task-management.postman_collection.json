{
  "info": {
    "name": "Task Management & Team Collaboration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl, email and password in a local Postman environment. Login and create operations populate the token and resource IDs in that environment."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register a User",
          "request": {
            "method": "POST",
            "description": "Public registration creates the User role.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Taylor\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const { data } = pm.response.json()",
                  "  pm.environment.set('accessToken', data.accessToken)",
                  "  pm.environment.set('userId', data.user.id)",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List visible projects",
          "request": {
            "method": "GET",
            "description": "Admins, the creator and users with a task assigned in this project can view it.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          }
        },
        {
          "name": "Create a project",
          "request": {
            "method": "POST",
            "description": "Any authenticated account can create a project.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const { data } = pm.response.json()",
                  "  pm.environment.set('projectId', data.id)",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read a project",
          "request": {
            "method": "GET",
            "description": "Admins, the creator and users with a task assigned in this project can view it.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            }
          }
        },
        {
          "name": "Update supplied project fields",
          "request": {
            "method": "PUT",
            "description": "Admins and the project creator may perform this operation. Supply at least one field.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website launch\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            }
          }
        },
        {
          "name": "Delete a project and its tasks",
          "request": {
            "method": "DELETE",
            "description": "Admins and the project creator may perform this operation.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Search and list visible tasks",
          "request": {
            "method": "GET",
            "description": "Admins, the project creator and the task assignee can view this task. Filters combine with AND. Results are newest ID first.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "backend",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Pending",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "Low",
                  "disabled": true
                },
                {
                  "key": "assigned_to",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "project_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Create a task",
          "request": {
            "method": "POST",
            "description": "Admins and the project creator may perform this operation. The assignment is optional and due_date is required.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend draft\",\n  \"project_id\": {{projectId}},\n  \"assigned_to\": {{userId}},\n  \"priority\": \"High\",\n  \"due_date\": \"2027-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  const { data } = pm.response.json()",
                  "  pm.environment.set('taskId', data.id)",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Read a task",
          "request": {
            "method": "GET",
            "description": "Admins, the project creator and the task assignee can view this task.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        },
        {
          "name": "Update supplied task fields",
          "request": {
            "method": "PUT",
            "description": "Admins and creators may update any documented field. Assignees may update status only. Supply at least one field.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        },
        {
          "name": "Delete a task",
          "request": {
            "method": "DELETE",
            "description": "Admins and the project creator may perform this operation.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Read dashboard statistics",
          "request": {
            "method": "GET",
            "description": "Admins receive global totals. Other users receive totals for their visible resources. assignedToMe is personal for every role.",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard",
                "stats"
              ]
            }
          }
        }
      ]
    }
  ]
}
